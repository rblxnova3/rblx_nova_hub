local function button(text, y, height)
    local b = new("TextButton", {
        Position = UDim2.new(0, 12, 0, y),
        Size = UDim2.new(1, -24, 0, height or 34),
        BackgroundColor3 = BUTTON_BG,
        Text = text,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamBold,
        TextSize = 13
    }, panel)
